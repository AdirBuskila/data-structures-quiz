     "step": {
      "type": "findbug",
      "prompt": "הקוד הבא אמור להריץ heapify-down בערימת **מינימום**, אבל יש בו שורה אחת שגויה. איזו?",
      "code": true,
      "lines": [
       "def down(A, n, i):",
       "    while 2*i+1 < n:",
       "        c = 2*i+1",
       "        if c+1 < n and A[c+1] > A[c]: c += 1",
       "        if A[i] <= A[c]: break",
       "        A[i], A[c] = A[c], A[i]",
       "        i = c"
      ]
     }
    },
